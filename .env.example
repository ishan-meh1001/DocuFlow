# Supabase Auth. The anon key is public; database credentials stay server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL URL for a local or managed database with pgvector installed.
DATABASE_URL=

# GitHub App settings. Store the PEM key with literal \n characters.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Inngest serves jobs locally with `npx inngest-cli@latest dev`.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# OpenAI-compatible embedding endpoint; document text is sent only to this
# explicitly configured endpoint. The selected model must return 1536 values.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
